# Copy to .env.local and fill in. Everything prefixed EXPO_PUBLIC_ ends up in the app bundle,
# so only public values go here. Secrets live in the Worker (see worker/README.md).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_ASK_CLAUDE_URL=https://mypetravel-api.your-subdomain.workers.dev
